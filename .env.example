# Supabase — dari Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key...

# Auth admin tunggal
ADMIN_PASSWORD=tukar-kata-laluan-ini
JWT_SECRET=rentetan-rawak-panjang-untuk-tandatangan-jwt

# (opsyenal) untuk `vite` tanpa `vercel dev` — proksi /api ke host lain
# VITE_API_PROXY=http://localhost:3000
